# --- Застосунок ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- База даних ---
DATABASE_URL=postgresql+psycopg://messenger:messenger@localhost:5432/messenger

# --- Безпека (обовʼязково змініть SECRET_KEY: openssl rand -hex 32) ---
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Файли ---
UPLOAD_DIR=uploads

# --- Початковий адміністратор (створюється при старті, якщо задано) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# Задайте власний пароль (не публікуйте його). Якщо залишити порожнім, адміністратор не створюється.
ADMIN_PASSWORD=
