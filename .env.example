# Скопіюйте у .env і заповніть перед `docker compose up`.

# --- PostgreSQL ---
POSTGRES_USER=messenger
# POSTGRES_PASSWORD: згенеруйте, наприклад, командою `openssl rand -hex 24`
POSTGRES_PASSWORD=
POSTGRES_DB=messenger
POSTGRES_PORT=5432

# --- Бекенд ---
# SECRET_KEY: згенеруйте, наприклад, командою `openssl rand -hex 32`
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# COOKIE_SECURE=true лише за HTTPS (інакше браузер відкине refresh-cookie)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Порт(и), з яких фронтенд звертається до бекенду напряму (не через nginx-проксі)
CORS_ORIGINS=http://localhost:8080
RATE_LIMIT_ENABLED=true
BACKEND_PORT=8000

# Початковий адміністратор — створюється автоматично при першому старті
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Фронтенд ---
FRONTEND_PORT=8080
